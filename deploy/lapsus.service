[Unit]
Description=lapsus: RU/EN layout auto-fixer for niri
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Needs the session environment in the systemd user manager:
# WAYLAND_DISPLAY (wtype, wl-clipboard) and NIRI_SOCKET (niri msg).
# The niri session imports them; otherwise run once:
#   systemctl --user import-environment WAYLAND_DISPLAY NIRI_SOCKET
ExecStart=%h/.local/bin/lapsus daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
